APP_NAME="Laravel PicTweet"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
TRUSTED_HOSTS=localhost,127.0.0.1
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Laravel PicTweet"

# Production must set APP_DEBUG=false, APP_URL, TRUSTED_HOSTS, APP_KEY,
# secure cookie settings, and a real mail transport before deployment.
